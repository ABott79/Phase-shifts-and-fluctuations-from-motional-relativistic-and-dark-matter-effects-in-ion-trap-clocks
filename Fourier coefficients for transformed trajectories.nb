Notebook[{
Cell[TextData[{
 "The  following code calculates the Fourier coefficients contained in tables \
III-V of the paper. The coefficients are calculated to second order in the \
Mathieu parameter q, while the characteristic exponent \[Mu] is assumed to be \
O(q). The parameter a is eliminated from all expressions using ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Mu]", "2"], "=", 
    RowBox[{"a", "+", 
     RowBox[{
      SuperscriptBox["q", "2"], "/", "2"}]}]}], TraditionalForm]],
  ExpressionUUID->"0144896d-1e43-4042-bf68-17d8eb5f5828"],
 ". To realise a simultaneous series expansion in both q and \[Mu], we use \
the expansion parameter \[Lambda] , i.e. we replace q-> q*\[Lambda] and \
\[Mu]->\[Mu]*\[Lambda]. The expansion parameter \[Lambda] is set to 1 when \
generating the tables for the paper."
}], "Text",
 CellChangeTimes->{{4.000970013143149*^9, 4.000970051170918*^9}, {
  4.000970090979947*^9, 4.000970168807559*^9}, {4.000970234723845*^9, 
  4.000970316859522*^9}, {4.0011364776928444`*^9, 4.001136483781756*^9}, {
  4.0011365901444416`*^9, 4.0011365905121164`*^9}, {4.00113682807712*^9, 
  4.001136967400751*^9}},ExpressionUUID->"b9ef6184-5d1a-4707-b218-\
e9205c1a0125"],

Cell[CellGroupData[{

Cell["Initial  definitions", "Subsubsection",
 CellChangeTimes->{{4.001136572711378*^9, 
  4.0011365802940826`*^9}},ExpressionUUID->"1c725945-186e-8441-b48b-\
579a366d2d8c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Inserts", " ", "the", " ", "expansion", " ", "parameter", " ", 
    "\[Lambda]", " ", "outside", " ", "of", " ", "trigonometric", " ", 
    "functions", " ", "and", " ", "exponentials"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"InsertLambda", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"x", "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"q", ":>", 
          RowBox[{"q", "*", "\[Lambda]"}]}], ",", 
         RowBox[{"\[Mu]", ":>", 
          RowBox[{"\[Mu]", "*", "\[Lambda]"}]}]}], "}"}]}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Cos", "[", "y_", "]"}], ":>", 
         RowBox[{"Cos", "[", 
          RowBox[{"y", "/.", 
           RowBox[{"\[Lambda]", ":>", "1"}]}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"Sin", "[", "y_", "]"}], ":>", 
         RowBox[{"Sin", "[", 
          RowBox[{"y", "/.", 
           RowBox[{"\[Lambda]", ":>", "1"}]}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"Exp", "[", "y_", "]"}], ":>", 
         RowBox[{"Exp", "[", 
          RowBox[{"y", "/.", 
           RowBox[{"\[Lambda]", ":>", "1"}]}], "]"}]}]}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Calculates", " ", "the", " ", "series", " ", "expansion", " ", "of", 
      " ", "expr", " ", "to", " ", "n"}], "-", 
     RowBox[{"th", " ", "order", " ", "in", " ", "\[Lambda]"}]}], " ", "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Lambda]Series", "[", 
      RowBox[{"expr_", ",", "n_"}], "]"}], ":=", 
     RowBox[{"Normal", "[", 
      RowBox[{"Series", "[", 
       RowBox[{
        RowBox[{"Expand", "[", "expr", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Lambda]", ",", "0", ",", "n"}], "}"}]}], "]"}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{4.001136564343368*^9, 4.001136569830252*^9}, {
  4.001136977581363*^9, 4.001137004992922*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"520e3b53-f4fd-c349-8994-88936c8edaab"],

Cell[BoxData["\[IndentingNewLine]"], "Input",
 CellChangeTimes->{4.001136600737188*^9},
 CellLabel->"In[3]:=",ExpressionUUID->"49802e47-c5fd-4d47-a347-04ec9c9cec1f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Calculation of Mathieu-coefficients ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[Xi]", "i"], 
    RowBox[{"(", "k", ")"}]], TraditionalForm]],ExpressionUUID->
  "3291ea3f-ecc6-6d45-a31e-bd043641d15d"],
 " of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Epsilon]", "i"], TraditionalForm]],ExpressionUUID->
  "c31387f4-e3e0-124a-a7b9-8e76d257c892"],
 " from their recursion relation"
}], "Subsubsection",
 CellChangeTimes->{{4.001136306435946*^9, 
  4.0011363695612774`*^9}},ExpressionUUID->"9c7793a3-2315-194e-8318-\
4475dd73cd49"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Solves", " ", "the", " ", "recursion", " ", "relation", " ", 
      SubscriptBox["q", "i"], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["\[Xi]", "i"], 
         RowBox[{"(", 
          RowBox[{"k", "+", "1"}], ")"}]], "+", 
        SuperscriptBox[
         SubscriptBox["\[Xi]", "i"], 
         RowBox[{"(", 
          RowBox[{"k", "-", "1"}], ")"}]]}], ")"}]}], "==", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["a", "i"], "-", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "2"}], "+", 
           SubscriptBox["\[Mu]", "i"]}], ")"}], "2"]}], ")"}], 
      SuperscriptBox[
       SubscriptBox["\[Xi]", "i"], 
       RowBox[{"(", "k", ")"}]], " ", "for", " ", "the", " ", "coefficients", 
      " ", 
      SuperscriptBox[
       SubscriptBox["\[Xi]", "i"], 
       RowBox[{"(", "k", ")"}]], " ", "in", " ", "the", " ", "Fourier", " ", 
      "expansion", " ", "of", " ", "the", " ", "quantized", " ", "positions", 
      " ", "amplitude", " ", 
      SubscriptBox["\[Epsilon]", "i"], " ", "in", " ", "terms", " ", "of", 
      " ", "the", " ", "coefficient", " ", 
      SuperscriptBox[
       SubscriptBox["\[Xi]", "i"], 
       RowBox[{"(", "0", ")"}]], " ", "up", " ", "to", " ", "k"}]}], "=", 
    RowBox[{
     RowBox[{"5", " ", "by", " ", "neglecting", " ", 
      RowBox[{"terms", " ", "~", 
       SuperscriptBox[
        SubscriptBox["\[Xi]", "i"], 
        RowBox[{"(", 
         RowBox[{"\[PlusMinus]", "6"}], ")"}]]}]}], "=", 
     RowBox[{"O", 
      RowBox[{"(", 
       SuperscriptBox["q", "6"], ")"}]}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "The", " ", "solutions", " ", "are", " ", "put", " ", "into", " ", "a", 
    " ", "list", " ", "from", " ", 
    SuperscriptBox[
     SubscriptBox["\[Xi]", "i"], 
     RowBox[{"(", 
      RowBox[{"-", "6"}], ")"}]], " ", "to", " ", 
    SuperscriptBox[
     SubscriptBox["\[Xi]", "i"], 
     RowBox[{"(", "6", ")"}]]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"The", " ", "coefficient", " ", 
    SuperscriptBox[
     SubscriptBox["\[Xi]", "i"], 
     RowBox[{"(", "0", ")"}]], " ", "is", " ", "inserted", " ", "manually", 
    " ", "into", " ", "the", " ", "middle", " ", "of", " ", "the", " ", 
    "list", " ", "and", " ", "determined", " ", "later"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"coeffList", "=", 
    RowBox[{"Insert", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"q", "*", 
              SubscriptBox["\[Xi]", "4"]}], "==", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"a", "-", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"10", "+", "\[Mu]"}], ")"}], "2"]}], ")"}], 
              SubscriptBox["\[Xi]", "5"]}]}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"q", 
              RowBox[{"(", 
               RowBox[{
                SubscriptBox["\[Xi]", "5"], "+", 
                SubscriptBox["\[Xi]", "3"]}], ")"}]}], "==", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"a", "-", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"8", "+", "\[Mu]"}], ")"}], "2"]}], ")"}], 
              SubscriptBox["\[Xi]", "4"]}]}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"q", 
              RowBox[{"(", 
               RowBox[{
                SubscriptBox["\[Xi]", "4"], "+", 
                SubscriptBox["\[Xi]", "2"]}], ")"}]}], "==", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"a", "-", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"6", "+", "\[Mu]"}], ")"}], "2"]}], ")"}], 
              SubscriptBox["\[Xi]", "3"]}]}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"q", 
              RowBox[{"(", 
               RowBox[{
                SubscriptBox["\[Xi]", "3"], "+", 
                SubscriptBox["\[Xi]", "1"]}], ")"}]}], "==", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"a", "-", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"4", "+", "\[Mu]"}], ")"}], "2"]}], ")"}], 
              SubscriptBox["\[Xi]", "2"]}]}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"q", 
              RowBox[{"(", 
               RowBox[{
                SubscriptBox["\[Xi]", "2"], "+", 
                SubscriptBox["\[Xi]", "0"]}], ")"}]}], "==", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"a", "-", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"2", "+", "\[Mu]"}], ")"}], "2"]}], ")"}], 
              SubscriptBox["\[Xi]", "1"]}]}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"q", 
              RowBox[{"(", 
               RowBox[{
                SubscriptBox["\[Xi]", "0"], "+", 
                SubscriptBox["\[Xi]", 
                 RowBox[{"-", "2"}]]}], ")"}]}], "==", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"a", "-", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"-", "2"}], "+", "\[Mu]"}], ")"}], "2"]}], ")"}], 
              SubscriptBox["\[Xi]", 
               RowBox[{"-", "1"}]]}]}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"q", 
              RowBox[{"(", 
               RowBox[{
                SubscriptBox["\[Xi]", 
                 RowBox[{"-", "1"}]], "+", 
                SubscriptBox["\[Xi]", 
                 RowBox[{"-", "3"}]]}], ")"}]}], "==", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"a", "-", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"-", "4"}], "+", "\[Mu]"}], ")"}], "2"]}], ")"}], 
              SubscriptBox["\[Xi]", 
               RowBox[{"-", "2"}]]}]}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"q", 
              RowBox[{"(", 
               RowBox[{
                SubscriptBox["\[Xi]", 
                 RowBox[{"-", "2"}]], "+", 
                SubscriptBox["\[Xi]", 
                 RowBox[{"-", "4"}]]}], ")"}]}], "==", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"a", "-", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"-", "6"}], "+", "\[Mu]"}], ")"}], "2"]}], ")"}], 
              SubscriptBox["\[Xi]", 
               RowBox[{"-", "3"}]]}]}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"q", 
              RowBox[{"(", 
               RowBox[{
                SubscriptBox["\[Xi]", 
                 RowBox[{"-", "3"}]], "+", 
                SubscriptBox["\[Xi]", 
                 RowBox[{"-", "5"}]]}], ")"}]}], "==", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"a", "-", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"-", "8"}], "+", "\[Mu]"}], ")"}], "2"]}], ")"}], 
              SubscriptBox["\[Xi]", 
               RowBox[{"-", "4"}]]}]}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"q", "*", 
              SubscriptBox["\[Xi]", 
               RowBox[{"-", "4"}]]}], "==", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"a", "-", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"-", "10"}], "+", "\[Mu]"}], ")"}], "2"]}], ")"}], 
              SubscriptBox["\[Xi]", 
               RowBox[{"-", "5"}]]}]}]}], "\[IndentingNewLine]", "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            SubscriptBox["\[Xi]", 
             RowBox[{"-", "5"}]], ",", 
            SubscriptBox["\[Xi]", 
             RowBox[{"-", "4"}]], ",", 
            SubscriptBox["\[Xi]", 
             RowBox[{"-", "3"}]], ",", 
            SubscriptBox["\[Xi]", 
             RowBox[{"-", "2"}]], ",", 
            SubscriptBox["\[Xi]", 
             RowBox[{"-", "1"}]], ",", 
            SubscriptBox["\[Xi]", "1"], ",", 
            SubscriptBox["\[Xi]", "2"], ",", 
            SubscriptBox["\[Xi]", "3"], ",", 
            SubscriptBox["\[Xi]", "4"], ",", 
            SubscriptBox["\[Xi]", "5"]}], "}"}]}], "]"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
      SubscriptBox["\[Xi]", "0"], ",", "6"}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.996131403012288*^9, 3.996131594850378*^9}, {
