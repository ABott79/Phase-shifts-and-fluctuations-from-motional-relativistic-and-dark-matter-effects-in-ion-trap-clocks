Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Now", " ", "that", " ", 
     SuperscriptBox[
      SubscriptBox["\[Xi]", "i"], 
      RowBox[{"(", "0", ")"}]], " ", "is", " ", "known"}], ",", " ", 
    RowBox[{
    "we", " ", "can", " ", "finalize", " ", "the", " ", "calculations", " ", 
     "of", " ", "the", " ", "other", " ", 
     SuperscriptBox[
      SubscriptBox["\[Xi]", "i"], 
      RowBox[{"(", 
       RowBox[{"n", "!=", "0"}], ")"}]], " ", "by", " ", "inserting", " ", 
     SuperscriptBox[
      SubscriptBox["\[Xi]", "i"], 
      RowBox[{"(", "0", ")"}]]}], ",", " ", 
    RowBox[{
    "inserting", " ", "\[Lambda]", " ", "and", " ", "then", " ", "expanding", 
     " ", "in", " ", "\[Lambda]"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"apprCoeffList", "=", 
    RowBox[{"\[Lambda]Series", "[", 
     RowBox[{
      RowBox[{"InsertLambda", "[", 
       RowBox[{"coeffList", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"a", ":>", 
           RowBox[{
            SuperscriptBox["\[Mu]", "2"], "-", 
            FractionBox[
             SuperscriptBox["q", "2"], "2"]}]}], ",", 
          RowBox[{"\[Lambda]", ":>", "1"}]}], "}"}]}], "]"}], ",", "4"}], 
     "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.996228049923153*^9, 3.9962280541121063`*^9}, {
   3.99622809469605*^9, 3.996228118734882*^9}, {3.996228223279745*^9, 
