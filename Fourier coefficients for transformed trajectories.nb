Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Calculates", " ", 
    SuperscriptBox[
     SubscriptBox["\[Xi]", "i"], 
     RowBox[{"(", "0", ")"}]], " ", "using", " ", "the", " ", "relation", " ",
     "obtained", " ", "from", " ", "the", " ", "Wronskian", " ", "condition", 
    " ", "in", " ", "the", " ", "paper", " ", "together", " ", "with", " ", 
    "the", " ", "results", " ", "for", " ", "the", " ", "other", " ", 
    "coefficients", " ", "in", " ", 
    RowBox[{"coeffList", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    SubscriptBox["\[Xi]", "0"], "=", 
    RowBox[{"\[Lambda]Series", "[", 
     RowBox[{
      RowBox[{"InsertLambda", "[", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               FractionBox[
                RowBox[{"coeffList", "[", 
                 RowBox[{"[", 
                  RowBox[{"k", "+", "6"}], "]"}], "]"}], 
                RowBox[{"coeffList", "[", 
                 RowBox[{"[", "6", "]"}], "]"}]], ")"}], "2"], 
             RowBox[{"(", 
              RowBox[{"1", "+", 
               FractionBox[
                RowBox[{"2", "k"}], "\[Mu]"]}], ")"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", 
              RowBox[{"-", "5"}], ",", "5"}], "}"}]}], "]"}], ")"}], 
         RowBox[{
          RowBox[{"-", "1"}], "/", "2"}]], "/.", 
        RowBox[{"{", 
         RowBox[{"a", ":>", 
          RowBox[{
           SuperscriptBox["\[Mu]", "2"], "-", 
           FractionBox[
            SuperscriptBox["q", "2"], "2"]}]}], "}"}]}], "]"}], ",", "4"}], 
     "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{
  3.996227741786415*^9, {3.996227940247305*^9, 3.9962279413592625`*^9}, {
   3.996227996574186*^9, 3.996228021903024*^9}, {3.996228075143585*^9, 
