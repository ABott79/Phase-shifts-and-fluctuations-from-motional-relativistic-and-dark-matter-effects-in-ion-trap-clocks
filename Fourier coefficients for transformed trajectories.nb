Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Returns", " ", "the", " ", "coefficient", " ", 
    SuperscriptBox[
     SubscriptBox["\[Xi]", "i"], 
     RowBox[{"(", "k", ")"}]], " ", "from", " ", "the", " ", "list", " ", 
    "apprCoeffList", " ", "to", " ", "include", " ", "the", " ", "index", " ",
     "shift", " ", "and", " ", "simplify", " ", "notation"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
